---
import Base from '../../layouts/Base.astro';
import { events } from '../../lib/data';
export function getStaticPaths() { return events.map(event => ({ params: { id: event.id }, props: { event } })); }
const { event: e } = Astro.props;
---
<Base title={e.title} description={e.summary}><article class="detail"><p><a href="/">← 返回事件图谱</a></p><div class="event-meta"><time datetime={e.event_date}>{e.event_date.slice(0,10)}</time><span class="badge" data-impact={e.impact}>{e.impact} 级</span><span>{e.category} / {e.subcategory}</span></div><h1>{e.title}</h1><p class="intro">{e.summary}</p><dl><dt>分级理由</dt><dd>{e.impact_reason}</dd><dt>机构</dt><dd>{e.orgs.join('、')}</dd><dt>模型</dt><dd>{e.models?.join('、') || '未标注'}</dd><dt>确认状态 / 日期依据</dt><dd>{e.verified} / {e.date_basis ?? '未标注'}</dd>{e.status && <><dt>进展状态</dt><dd>{e.status}</dd></>}{e.note && <><dt>补充说明</dt><dd>{e.note}</dd></>}</dl><h2>可追溯来源</h2><ul>{e.sources.map(s => <li><a href={s.url} rel="noopener nofollow" target="_blank">{s.publisher}</a> <span class="muted">（{s.type}）</span></li>)}</ul><h2>关联事件</h2>{e.related_ids?.length ? <ul>{e.related_ids.map(id => <li><a href={`/events/${id}/`}>{events.find(v => v.id === id)?.title ?? id}</a></li>)}</ul> : <p class="muted">暂无关联事件。</p>}<h2>分级调整记录</h2>{e.impact_history?.length ? <ul>{e.impact_history.map(h => <li><time>{h.at}</time> · {h.from} → {h.to}<p>{h.reason}</p></li>)}</ul> : <p class="muted">暂无分级调整。</p>}<p class="muted">事件 ID：{e.id}<br />建立：{e.created_at}<br />更新：{e.updated_at}</p></article></Base>
