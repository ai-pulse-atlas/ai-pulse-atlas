---
import Base from '../layouts/Base.astro';
import { events, page } from '../lib/data';
const orgs = [...new Set(events.flatMap(e => e.orgs))].sort();
const categories = page.taxonomy.map(c => c.name);
---
<Base title="AI 行业事件图谱">
<p class="eyebrow">AI INDUSTRY / OPEN DATA</p><h1>记录 AI 的变化，<br />看见影响力的走向。</h1><p class="intro">按影响力分级、可追溯官方来源的 AI 行业事件开放数据集与可视化</p>
<p class="muted">统计窗口 {page.window.start} 至 {page.asof} · 周一为周起点 · 北京时间</p>
<section class="metrics" aria-label="关键指标"><div class="metric">窗口内事件<strong>{page.metrics.total}</strong></div>{Object.entries(page.metrics.by_impact).map(([level, n]) => <div class="metric">{level} 级<strong>{n}</strong></div>)}<div class="metric">最热分类<strong>{page.metrics.hottest_category ?? '暂无'}</strong><small>按累计影响力指数</small></div></section>
<section class="panel"><h2>分类 × 周热力图</h2><p class="muted">颜色表示事件数量，查看每一周的行业焦点。</p><div id="heatmap" class="chart" role="img" aria-label="分类每周事件数热力图"></div></section>
<section class="panel"><h2>分类周影响力指数</h2><p class="muted">S × 8 + A × 4 + B × 2 + C × 1；各分类独立折线。</p><div id="trend" class="chart" role="img" aria-label="各分类每周影响力指数折线图"></div><details><summary>查看图表数据表（无需脚本）</summary><div class="table-scroll"><table><thead><tr><th>分类 / 周起点</th>{page.weeks.map(w => <th>{w}</th>)}</tr></thead><tbody>{categories.map(c => <tr><th>{c} · 指数</th>{page.agg.category_week_index[c].map(n => <td>{n}</td>)}</tr>)}{categories.map(c => <tr><th>{c} · 事件数</th>{page.weeks.map(w => <td>{Object.values(page.agg.category_impact_week[c]?.[w] ?? {}).reduce((a:number,b:number) => a+b,0)}</td>)}</tr>)}</tbody></table></div></details></section>
<h2>事件时间线</h2><p>全量收录 {events.length} 条 · <a href="/data/events.jsonl">下载 JSONL</a></p>
<form class="filters" id="filters" hidden role="search"><label>等级<select name="impact"><option value="">全部等级</option>{['S','A','B','C'].map(v => <option>{v}</option>)}</select></label><label>分类<select name="category"><option value="">全部分类</option>{categories.map(v => <option>{v}</option>)}</select></label><label>机构<select name="org"><option value="">全部机构</option>{orgs.map(v => <option>{v}</option>)}</select></label><label>关键词<input name="keyword" type="search" placeholder="搜索标题、摘要、模型" /></label></form><p id="results" aria-live="polite"></p>
<ul class="timeline">{events.map(e => <li class="event" data-impact={e.impact} data-category={e.category} data-orgs={JSON.stringify(e.orgs)} data-search={[e.title,e.summary,...e.orgs,...(e.models ?? [])].join(' ').toLowerCase()}><div class="event-meta"><time datetime={e.event_date}>{e.event_date.slice(0,10)}</time><span class="badge" data-impact={e.impact}>{e.impact}</span><span>{e.category}</span></div><h3><a href={`/events/${e.id}/`}>{e.title}</a></h3><p>{e.summary}</p><small>{e.orgs.join(' · ')}</small></li>)}</ul>
<script id="chart-data" type="application/json" set:html={JSON.stringify(page).replace(/</g,'\\u003c')} />
<script>
import '../lib/home';
</script>
</Base>
