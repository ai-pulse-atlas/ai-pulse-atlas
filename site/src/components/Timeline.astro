---
import { events, page } from '../lib/data';
import { grades, monday, credibility } from '../lib/presentation';
import GradeBadge from './GradeBadge.astro';
const day = (d: string) => Date.parse(d.slice(0,10) + 'T00:00:00Z') / 86400000;
const first = events.map(e => e.event_date.slice(0,10)).sort()[0] ?? page.asof;
const start = day(monday(first));
const end = day(page.asof);
const width = Math.max(1000, (end-start)*24 + 160);
const x = (d: string) => 116 + (day(d)-start)/Math.max(1,end-start)*(width-144);
let bottom = 40;
const lanes = page.taxonomy.map((category: {name: string}) => {
  const counts: Record<string, number> = {};
  const points = events.filter(e => e.category === category.name).sort((a,b) => grades.indexOf(a.impact)-grades.indexOf(b.impact)).map(e => {
    const date = e.event_date.slice(0,10);
    const stack = counts[date] ?? 0; counts[date] = stack+1;
    return { event:e, stack };
  });
  const height = Math.max(54, Math.max(0,...Object.values(counts))*24+20);
  const top = bottom; bottom += height;
  return { name:category.name, points, top, height };
});
const ticks = Array.from({length:Math.floor((end-start)/7)+1},(_,i) => new Date((start+i*7)*86400000).toISOString().slice(0,10));
const radius = {S:9,A:7,B:5,C:3.5};
---
<section class="panel" aria-labelledby="timeline-heading">
  <div class="section-heading"><div><p class="eyebrow">01 / 时间脉络</p><h2 id="timeline-heading">分类泳道时间线</h2></div><label class="toggle" id="timeline-control" hidden><input id="show-all" type="checkbox"/>显示全部等级（含 B/C）</label></div>
  <p class="muted">每条泳道对应一个分类。悬停、聚焦或点击圆点查看详情；横向滚动浏览日期。</p>
  <div class="grade-legend">{grades.map(grade => <span><svg width="22" height="22" aria-hidden="true"><circle cx="11" cy="11" r={radius[grade]} style={`fill:var(--grade-${grade})`}/></svg>{grade} 级 · {events.filter(e => e.impact===grade).length}</span>)}<span id="timeline-count" aria-live="polite">当前显示 {events.filter(e => ['S','A'].includes(e.impact)).length} 条</span></div>
  <div class="timeline-scroll" tabindex="0" role="region" aria-label="可横向滚动的分类时间线">
    <svg class="lane-chart" viewBox={`0 0 ${width} ${bottom+8}`} style={`min-width:${Math.max(760,width*.76)}px`} aria-label="按日期与分类排列的事件">
      {lanes.map((lane,i) => <rect x="0" y={lane.top} width={width} height={lane.height} class:list={['lane-background',{'alternate':i%2===0}]}/>)}
      {ticks.map(tick => <g><line class="tick" x1={x(tick)} x2={x(tick)} y1="32" y2={bottom}/><text x={x(tick)} y="22" text-anchor="middle">{tick.slice(5)}</text></g>)}
      {lanes.map(lane => <g><text x="12" y={lane.top+lane.height/2+5} class="lane-label">{lane.name}</text>{lane.points.map(({event:e,stack}) => <a class="timeline-point" data-id={e.id} data-impact={e.impact} href={`/events/${e.id}/`} tabindex="0" aria-label={`${e.event_date} ${e.impact} 级 ${e.title}`}><title>{e.event_date} · {e.impact} 级 · {e.title}</title><circle cx={x(e.event_date)} cy={lane.top+20+stack*24} r={radius[e.impact]} style={`fill:var(--grade-${e.impact})`}/></a>)}</g>)}
    </svg>
  </div>
  <div id="timeline-detail" class="timeline-detail" aria-live="polite" aria-atomic="true"><p class="muted">悬停、聚焦或点击圆点查看事件详情。未启用脚本时，圆点直接打开事件独立页。</p></div>
  {events.map(e => <template data-detail={e.id}><div class="event-meta"><GradeBadge grade={e.impact}/><time>{e.event_date}</time><span class="credibility" data-verified={e.verified}>{credibility[e.verified]}</span></div><h3>{e.title}</h3><p class="muted">{e.category} · {e.subcategory} · {e.orgs.join('、')}</p><p>{e.summary}</p><p><strong>定级理由：</strong>{e.impact_reason}</p><div class="event-meta">{e.sources[0] && <a href={e.sources[0].url} target="_blank" rel="noopener nofollow">{e.sources[0].publisher} ↗</a>}<a href={`/events/${e.id}/`}>打开独立页 →</a></div></template>)}
</section>
