---
import '../styles/global.css';
const { title = 'AI Pulse Atlas', description = '按影响力分级、可追溯官方来源的 AI 行业事件开放数据集与可视化' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="color-scheme" content="light dark" /><meta name="theme-color" content="#f3f5f7" media="(prefers-color-scheme: light)" /><meta name="theme-color" content="#101820" media="(prefers-color-scheme: dark)" /><meta name="description" content={description} /><title>{title} · AI Pulse Atlas</title><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} /></head>
<body><a class="skip-link" href="#main">跳到主要内容</a><header><a class="brand" href="/">AI PULSE <span>ATLAS</span></a><nav aria-label="主导航"><a href="/">事件图谱</a><a href="/about/">关于与投稿</a><a href="/data/events.json">下载 JSON</a></nav></header><main id="main" tabindex="-1"><slot /></main><footer><span>开放记录 · 有据可循</span><span>数据与项目自写文字 CC BY 4.0 · 代码 MIT · <a href="/about/">许可与引用说明</a></span></footer><button id="back-top" class="back-top" type="button" hidden aria-label="回到顶部">↑</button>
<script>
  const button = document.querySelector<HTMLButtonElement>('#back-top')!;
  const update = () => { button.hidden = window.scrollY <= window.innerHeight * 1.5; };
  window.addEventListener('scroll', update, {passive:true}); update();
  button.addEventListener('click', () => {
    document.querySelector<HTMLElement>('#main')!.focus({preventScroll:true});
    window.scrollTo({top:0,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'});
  });
</script></body>
</html>
